{{!-- ═══════════════════════════════════════════════════════════════════════
     TILT — one normalized orientation signal for every scene and effect.

     Exposes window.M4Tilt with smoothed { x, y } in -1..1, so WebGL
     scenes, DOM parallax and text effects all read the same input rather
     than each attaching their own listeners.

     ── Why it is built this way ──────────────────────────────────────────
     • iOS (13+) requires DeviceOrientationEvent.requestPermission() from
       inside a user gesture. Without it Safari fires NOTHING, silently —
       no error, no events. So the first tap or click anywhere arms it,
       and until then the pointer fallback drives the signal.
     • Android/Chrome needs no prompt but does need a secure context.
     • Raw readings are jittery, so values are low-pass filtered. Scenes
       want a smooth signal, not sensor noise.
     • Axes rotate with the device, so screen.orientation.angle is
       compensated for — otherwise landscape tilts the wrong way.
     • prefers-reduced-motion DAMPS the signal rather than zeroing it.
       Tilt parallax is exactly the vestibular-triggering kind of motion,
       unlike the ambient ember field, so this is where restraint belongs.
     • Desktop has no gyro: pointer position drives the same signal, so a
       scene never needs to know which input it is reading.
═══════════════════════════════════════════════════════════════════════ --}}

<style>
  .m4-motion-ask {
    position: fixed; left: 50%; transform: translateX(-50%);
    bottom: 4.5rem;                      /* clears the fixed .ix-nav rail */
    z-index: 50; max-width: min(92vw, 24rem);
    display: flex; align-items: center; gap: .9rem;
    padding: .85rem 1rem;
    background: var(--blank, #110f16); color: var(--title-color, inherit);
    border: 1px solid var(--gray-200, #2a2a2a); border-radius: .75rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.35);
  }
  .m4-motion-ask p { margin: 0; font-size: .85rem; line-height: 1.3; }
  .m4-motion-actions { display: flex; gap: .4rem; flex: none; }
  .m4-motion-ask button {
    appearance: none; cursor: pointer; border-radius: 999px;
    padding: .4rem .9rem; font: 600 .78rem/1 inherit;
    border: 1px solid var(--gray-200, #2a2a2a);
    background: transparent; color: inherit;
  }
  .m4-motion-ask button[data-yes] {
    background: var(--ghost-accent-color, #F73E05); border-color: transparent; color: #fff;
  }
</style>

<script>
(function () {
  var TAG = '[m4-tilt]';
  if (window.M4Tilt) return;

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DAMP = reduced ? 0.25 : 1;
  var SMOOTH = 0.12;                       // low-pass factor

  var target = { x: 0, y: 0 };
  var value = { x: 0, y: 0 };
  var source = 'none';
  var armed = false;

  function clamp(n) { return n < -1 ? -1 : n > 1 ? 1 : n; }

  function onOrient(e) {
    if (e.gamma === null && e.beta === null) return;
    source = 'gyro';
    var g = e.gamma || 0;                  // left/right, -90..90
    var b = e.beta || 0;                   // front/back, -180..180
    var angle = (screen.orientation && screen.orientation.angle) || window.orientation || 0;
    var x = g, y = b;
    if (angle === 90) { x = b; y = -g; }
    else if (angle === -90 || angle === 270) { x = -b; y = g; }
    else if (angle === 180) { x = -g; y = -b; }
    target.x = clamp(x / 35) * DAMP;
    target.y = clamp((y - 45) / 35) * DAMP; // 45° is a natural holding angle
  }

  function onPointer(e) {
    if (source === 'gyro') return;         // gyro wins once it is live
    source = 'pointer';
    target.x = clamp((e.clientX / window.innerWidth) * 2 - 1) * DAMP;
    target.y = clamp((e.clientY / window.innerHeight) * 2 - 1) * DAMP;
  }

  function tick() {
    value.x += (target.x - value.x) * SMOOTH;
    value.y += (target.y - value.y) * SMOOTH;
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  function listen() {
    window.addEventListener('deviceorientation', onOrient, { passive: true });
  }

  // iOS: arm on the first user gesture, which is the only moment the
  // permission call is allowed to run.
  function arm() {
    if (armed) return;
    armed = true;
    var DOE = window.DeviceOrientationEvent;
    if (DOE && typeof DOE.requestPermission === 'function') {
      DOE.requestPermission().then(function (state) {
        console.log(TAG + ' motion permission: ' + state);
        if (state === 'granted') listen();
      }).catch(function (err) {
        console.log(TAG + ' motion permission denied', err);
      });
    } else if (DOE) {
      listen();
    }
  }

  // ── Consent ───────────────────────────────────────────────────────
  // iOS asks once per origin and a refusal effectively sticks, so we
  // never spend that single prompt on an unexplained dialog. A priming
  // step appears after the hero has scrolled past -- by which point the
  // reader has seen what the animation is for -- and only "Allow" calls
  // requestPermission(), synchronously inside the click so the gesture
  // still counts.
  var STORE = 'm4_motion';
  function remembered() {
    try { return localStorage.getItem(STORE); } catch (e) { return null; }
  }
  function remember(v) {
    try { localStorage.setItem(STORE, v); } catch (e) {}
  }

  var needsPrompt = !!(window.DeviceOrientationEvent &&
                       typeof window.DeviceOrientationEvent.requestPermission === 'function');

  function buildPrompt() {
    var en = (document.documentElement.lang || '').indexOf('en') === 0 ||
             location.pathname.indexOf('/en/') === 0;
    var box = document.createElement('div');
    box.className = 'm4-motion-ask';
    box.setAttribute('role', 'dialog');
    box.setAttribute('aria-labelledby', 'm4-motion-q');
    box.innerHTML =
      '<p id="m4-motion-q">' + (en ? 'Allow site animations?' : '¿Permitir animaciones del sitio?') + '</p>' +
      '<div class="m4-motion-actions">' +
        '<button type="button" data-yes>' + (en ? 'Yes' : 'Sí') + '</button>' +
        '<button type="button" data-no>' + (en ? 'No' : 'No') + '</button>' +
      '</div>';

    box.querySelector('[data-yes]').addEventListener('click', function () {
      remember('granted');
      box.remove();
      arm();                              // gesture is live: prompt now
    });
    // A decline is NOT stored: the reader is asked again on a later
    // visit, when they may well want it. Only "granted" persists, since
    // re-asking for a permission already given is pure noise.
    box.querySelector('[data-no]').addEventListener('click', function () {
      box.remove();
      console.log(TAG + ' reader declined motion (will ask again next visit)');
    });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') box.remove();
    });

    document.body.appendChild(box);
    box.querySelector('[data-yes]').focus();
    return box;
  }

  function maybeAsk() {
    if (remembered() === 'granted') { arm(); return; }   // silent re-arm
    buildPrompt();
  }

  if (!needsPrompt) {
    // Android and desktop need no permission; the sensor is simply there.
    if (window.DeviceOrientationEvent) { listen(); armed = true; }
  } else if (remembered() === 'granted') {
    // Already allowed for this origin: re-arm quietly on any gesture.
    ['pointerdown', 'touchend', 'keydown'].forEach(function (ev) {
      window.addEventListener(ev, arm, { once: true, passive: true });
    });
  } else {
    // Ask once the hero has gone by.
    var hero = document.querySelector('.ix-hero');
    if (hero && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        if (!es[0].isIntersecting) { io.disconnect(); maybeAsk(); }
      }, { threshold: 0 });
      io.observe(hero);
    } else {
      window.addEventListener('scroll', function once() {
        if (window.scrollY > window.innerHeight * 0.8) {
          window.removeEventListener('scroll', once);
          maybeAsk();
        }
      }, { passive: true });
    }
  }

  window.addEventListener('pointermove', onPointer, { passive: true });

  window.M4Tilt = {
    get x() { return value.x; },
    get y() { return value.y; },
    get source() { return source; },
    get reduced() { return reduced; },
    arm: arm,
    ask: maybeAsk,
    reset: function () { try { localStorage.removeItem(STORE); } catch (e) {} }
  };
  console.log(TAG + ' ready ' + JSON.stringify({
    needsGesture: !!(window.DeviceOrientationEvent && typeof window.DeviceOrientationEvent.requestPermission === 'function'),
    reduced: reduced
  }));
})();
</script>
