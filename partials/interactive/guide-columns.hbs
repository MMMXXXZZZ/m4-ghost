{{!-- ═══════════════════════════════════════════════════════════════════════
     GUIDE COLUMNS — interactive presentation of a normally-published post.

     ── Architecture (measured, not assumed) ──────────────────────────────

     • LIGHT DOM, no shadow root. Ghost Portal binds member forms with a
       one-time document.querySelectorAll("form[data-members-form]") from
       a React lifecycle hook that runs AFTER its async init — i.e. after
       DOMContentLoaded, and after us. A signup card behind a shadow
       boundary is never found, so the waitlist card would be silently
       dead. Verified live: 2 forms moved into panels, all still queryable.

     • EACH PANEL CARRIES .post-body. That class is the only carrier of
       prose typography (_post.sass): link colour, heading colour, and
       list-style, which Tailwind's preflight otherwise resets to no
       bullets. Prose moved out of it loses all of that.

     • COLUMN MARKER: H1 if the post uses any (Ctrl+Alt+1), else H2. H1
       leaves both h2 and h3 free for structure inside a column. Each one
       is re-emitted as an h2 in its panel, since the post title is
       already the page h1 (article-header.hbs:5).

     • PER-COLUMN CONFIG: one Ghost HTML card immediately after the H1,
       holding a JSON block and optionally a raw <svg> icon. Ghost renders
       HTML cards as raw nodes between <!--kg-card-begin: html--> markers
       with NO wrapper element, so the card's contents are literally the
       heading's next siblings. Configuration therefore lives beside the
       content it configures: no slug lookup, survives rewording and
       reordering, needs no deploy.

           <script type="application/json" data-m4-col>
           { "bg":"#06120f", "title":"#e8f4f1", "link":"#7fffd4",
             "bgDark":"#030a08", "titleDark":"#f2fbf9",
             "icon":"accent",
             "font":{ "family":"'X', sans-serif", "weight":650 },
             "fontUrl":"https://…",
             "scene":"particles-cs" }
           </script>
           <svg viewBox="…">…</svg>

     • Content is MOVED, never copied. The server renders the whole
       article; crawlers get the prose in the main document.
═══════════════════════════════════════════════════════════════════════ --}}

<style>
  /* Column tokens. JS sets --m4-* on the panel; these map them onto the
     theme's own variables so every existing rule in _post.sass repaints
     itself. Dark values fall back to the light ones when unset. */
  .ix-panel[data-m4-styled] {
    --blank: var(--m4-bg);
    --title-color: var(--m4-title);
    --post-color-link: var(--m4-link);
    background-color: var(--m4-bg);
    transition: background-color 800ms cubic-bezier(.16, 1, .3, 1),
                color 800ms cubic-bezier(.16, 1, .3, 1);
  }
  html.dark .ix-panel[data-m4-styled] {
    --blank: var(--m4-bg-dark, var(--m4-bg));
    --title-color: var(--m4-title-dark, var(--m4-title));
    --post-color-link: var(--m4-link-dark, var(--m4-link));
    background-color: var(--m4-bg-dark, var(--m4-bg));
  }
  .ix-panel[data-m4-font] {
    font-family: var(--m4-font-family);
    font-weight: var(--m4-font-weight, inherit);
    font-style: var(--m4-font-style, inherit);
  }

  .ix { margin: 2rem 0 6rem; }
  .ix-cols { display: grid; gap: 2px; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
  .ix-col {
    appearance: none; border: 1px solid var(--gray-200, #2a2a2a);
    background: var(--m4-bg, var(--blank, #110f16)); color: var(--m4-title, inherit);
    padding: 1.25rem 1rem; min-height: 7.5rem; cursor: pointer;
    display: flex; align-items: flex-end; text-align: left;
    font: 600 .78rem/1.25 inherit; text-transform: uppercase; letter-spacing: .04em;
    transition: background-color .18s ease, color .18s ease;
  }
  .ix-col:hover, .ix-col:focus-visible,
  .ix-col[aria-expanded="true"] { background: var(--m4-link, var(--ghost-accent-color, #F73E05)); color: #fff; }
  .ix-col svg { width: 2.25rem; height: 2.25rem; display: block; }

  .ix-panel { display: none; }
  .ix-panel.is-open { display: block; }

  /* Locked marker: current column's symbol and title, top-left. */
  .ix-marker {
    position: fixed; top: 4.5rem; left: 1rem; z-index: 30;
    display: flex; align-items: center; gap: .55rem;
    pointer-events: none; max-width: min(60vw, 26rem);
  }
  .ix-marker svg { width: 1.6rem; height: 1.6rem; flex: none; color: var(--m4-link, var(--ghost-accent-color, #F73E05)); }
  .ix-marker span {
    font: 600 .72rem/1.2 inherit; text-transform: uppercase; letter-spacing: .05em;
    color: var(--title-color); opacity: .85;
  }

  .ix-nav {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: flex; gap: 2px; overflow-x: auto;
    background: var(--blank, #110f16); border-top: 1px solid var(--gray-200, #2a2a2a);
    padding: .4rem; scrollbar-width: none;
  }
  .ix-nav::-webkit-scrollbar { display: none; }
  .ix-nav button {
    appearance: none; border: 0; background: transparent; color: inherit;
    white-space: nowrap; padding: .5rem .8rem; cursor: pointer;
    font: 600 .7rem/1 inherit; text-transform: uppercase; letter-spacing: .04em;
    border-radius: 999px; display: flex; align-items: center; gap: .4rem;
  }
  .ix-nav button svg { width: 1.1rem; height: 1.1rem; }
  .ix-nav button[aria-current="true"] { background: var(--ghost-accent-color, #F73E05); color: #fff; }

  @media (max-width: 40rem) { .ix-cols { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .ix-col, .ix-panel[data-m4-styled] { transition: none; }
  }
</style>

<script>
(function () {
  var TAG = '[m4-ix]';
  var loadedFonts = {};

  // ── SVG hygiene ──────────────────────────────────────────────────────
  // Stock exports routinely ship a <style>.cls-1{fill:#231f20}</style>
  // alongside the paths. That beats fill="currentColor" and pins the icon
  // black in every column, so it goes. Scripts and on* handlers go too:
  // not distrust of the author, but a pasted icon shouldn't be able to run.
  function cleanSvg(svg) {
    Array.prototype.forEach.call(svg.querySelectorAll('style,script'), function (n) { n.remove(); });
    Array.prototype.forEach.call(svg.querySelectorAll('*'), function (n) {
      Array.prototype.slice.call(n.attributes).forEach(function (a) {
        if (/^on/i.test(a.name)) n.removeAttribute(a.name);
      });
    });
    if (!svg.getAttribute('fill')) svg.setAttribute('fill', 'currentColor');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    return svg;
  }

  // Rewrite the viewBox from the artwork's real bounds. Only when there
  // is none, or the declared one doesn't contain the geometry — so a
  // deliberately padded viewBox survives. Needs the node rendered.
  function fitSvg(svg) {
    if (svg.dataset.m4Fit === 'false') return;
    var box;
    try { box = svg.getBBox(); } catch (e) { return; }
    if (!box || !box.width || !box.height) return;

    var vb = (svg.getAttribute('viewBox') || '').split(/[\s,]+/).map(Number);
    var declared = vb.length === 4 && vb.every(function (n) { return !isNaN(n); }) ? vb : null;
    var contained = declared &&
      box.x >= declared[0] - 1 && box.y >= declared[1] - 1 &&
      box.x + box.width <= declared[0] + declared[2] + 1 &&
      box.y + box.height <= declared[1] + declared[3] + 1;
    if (contained) return;

    var pad = Math.max(box.width, box.height) * 0.02;
    svg.setAttribute('viewBox',
      (box.x - pad) + ' ' + (box.y - pad) + ' ' +
      (box.width + pad * 2) + ' ' + (box.height + pad * 2));
    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    console.log(TAG + ' refit svg viewBox -> ' + svg.getAttribute('viewBox') +
      (declared ? ' (was ' + declared.join(' ') + ')' : ' (none declared)'));
  }

  function applyConfig(panel, col, cfg) {
    if (!cfg) return;
    var map = { bg: '--m4-bg', title: '--m4-title', link: '--m4-link',
                bgDark: '--m4-bg-dark', titleDark: '--m4-title-dark', linkDark: '--m4-link-dark' };
    var styled = false;
    Object.keys(map).forEach(function (k) {
      if (cfg[k]) { panel.style.setProperty(map[k], cfg[k]); col.style.setProperty(map[k], cfg[k]); styled = true; }
    });
    if (styled) panel.setAttribute('data-m4-styled', '');

    if (cfg.font && cfg.font.family) {
      panel.style.setProperty('--m4-font-family', cfg.font.family);
      if (cfg.font.weight) panel.style.setProperty('--m4-font-weight', cfg.font.weight);
      if (cfg.font.style) panel.style.setProperty('--m4-font-style', cfg.font.style);
      panel.setAttribute('data-m4-font', '');
    }
    if (cfg.fontUrl && !loadedFonts[cfg.fontUrl]) {
      loadedFonts[cfg.fontUrl] = true;
      var link = document.createElement('link');
      link.rel = 'stylesheet'; link.href = cfg.fontUrl;
      document.head.appendChild(link);
    }
    // Icon colour: currentColor by default, inheriting the column's title
    // token so it is correct in both modes with no config. "accent" opts
    // into the link colour; any other value is used verbatim.
    if (cfg.icon === 'accent') col.style.setProperty('--m4-icon', 'var(--m4-link)');
    else if (cfg.icon) col.style.setProperty('--m4-icon', cfg.icon);
    if (cfg.scene) panel.setAttribute('data-m4-scene', cfg.scene);
  }

  // Read the config card sitting immediately after a heading, and detach
  // it so it never lands in the panel.
  function readConfig(head) {
    var cfg = null, icon = null, n = head.nextElementSibling, scanned = 0;
    while (n && scanned < 4) {
      var next = n.nextElementSibling;
      if (n.matches('script[type="application/json"][data-m4-col]')) {
        try { cfg = JSON.parse(n.textContent); }
        catch (e) { console.warn(TAG + ' bad JSON in config block for "' + head.textContent.trim() + '"', e); }
        n.remove();
      } else if (n.tagName && n.tagName.toLowerCase() === 'svg' && !icon) {
        icon = cleanSvg(n); n.remove();
      } else if (cfg || icon) {
        break;                       // config card ended
      } else if (scanned > 0) {
        break;                       // nothing config-like directly after
      }
      n = next; scanned++;
    }
    return { cfg: cfg, icon: icon };
  }

  function init() {
    var body = document.getElementById('post-body');
    if (!body) { console.log(TAG + ' no #post-body'); return; }

    var marker = body.querySelector('h1:not(.kg-card h1)') ? 'H1' : 'H2';
    var markerSel = marker.toLowerCase();

    // Headings inside a Koenig card are card furniture, not structure: a
    // signup card's <h2 class="kg-signup-card-heading"> is its CTA. They
    // produced two bogus columns on the 2025 guide, and because such a
    // heading is nested, the sibling walk drained only the card's own
    // children and stranded the prose that followed.
    var sections = [];
    Array.prototype.forEach.call(body.querySelectorAll(markerSel), function (h) {
      if (h.closest('.kg-card')) return;
      var conf = readConfig(h);
      var sec = { title: h.textContent.trim(), id: h.id || '', head: h,
                  cfg: conf.cfg, icon: conf.icon, nodes: [] };
      var n = h.nextSibling;
      while (n) {
        if (n.nodeType === 1 && n.tagName === marker) break;
        var next = n.nextSibling;
        sec.nodes.push(n);
        n = next;
      }
      sections.push(sec);
    });

    console.log(TAG + ' marker=' + marker + ' sections parsed: ' + sections.length + ' ' +
      JSON.stringify(sections.map(function (s) { return s.title; })));

    if (!sections.length) {
      console.log(TAG + ' no section headings; leaving the article as published.');
      return;
    }

    var wrap = document.createElement('div'); wrap.className = 'ix';
    var cols = document.createElement('div'); cols.className = 'ix-cols';
    var panels = document.createElement('div'); panels.className = 'ix-panels';
    var nav = document.createElement('nav'); nav.className = 'ix-nav';
    nav.setAttribute('aria-label', document.documentElement.lang === 'en' ? 'Sections' : 'Secciones');

    var markerEl = document.createElement('div');
    markerEl.className = 'ix-marker';
    markerEl.setAttribute('aria-hidden', 'true');

    var entries = sections.map(function (s, i) {
      var slug = s.id || ('ix-' + i);

      var panel = document.createElement('section');
      panel.className = 'ix-panel post-body';
      panel.id = slug;

      var head = s.head;
      if (head.tagName === 'H1') {
        var h2 = document.createElement('h2');
        h2.className = head.className;
        h2.innerHTML = head.innerHTML;
        head.parentNode.removeChild(head);
        head = h2;
      }
      // The panel owns the anchor id; leaving it on the heading too would
      // duplicate it and make #hash resolve to whichever came first.
      head.removeAttribute('id');
      panel.appendChild(head);
      s.nodes.forEach(function (n) { panel.appendChild(n); });
      panels.appendChild(panel);

      var col = document.createElement('button');
      col.type = 'button';
      col.className = 'ix-col';
      col.setAttribute('aria-expanded', 'false');
      col.setAttribute('aria-controls', slug);
      // The icon is decorative; the accessible name is always the heading.
      col.setAttribute('aria-label', s.title);
      if (s.icon) col.appendChild(s.icon.cloneNode(true));
      else col.textContent = s.title;
      cols.appendChild(col);

      var navBtn = document.createElement('button');
      navBtn.type = 'button';
      navBtn.setAttribute('aria-current', 'false');
      navBtn.setAttribute('aria-label', s.title);
      if (s.icon) navBtn.appendChild(s.icon.cloneNode(true));
      navBtn.appendChild(document.createTextNode(s.title));
      nav.appendChild(navBtn);

      applyConfig(panel, col, s.cfg);

      return { slug: slug, title: s.title, panel: panel, col: col, nav: navBtn, icon: s.icon };
    });

    wrap.appendChild(cols);
    wrap.appendChild(panels);
    body.parentNode.insertBefore(wrap, body.nextSibling);
    document.body.appendChild(nav);
    document.body.appendChild(markerEl);

    // Icons must be rendered before getBBox can measure them.
    Array.prototype.forEach.call(document.querySelectorAll('.ix svg, .ix-nav svg'), fitSvg);

    var opened = {}, readFired = false;
    function track(title) {
      if (!window._paq) return;
      try {
        window._paq.push(['trackEvent', 'Guide', 'OpenColumn', title]);
        if (!readFired && Object.keys(opened).length >= 3) {
          readFired = true;
          window._paq.push(['trackEvent', 'Guide', 'Read', document.title]);
        }
      } catch (err) { console.warn(TAG + ' analytics push failed', err); }
    }

    function open(slug, push) {
      entries.forEach(function (e) {
        var on = e.slug === slug;
        e.panel.classList.toggle('is-open', on);
        // hidden="until-found" keeps closed panels out of layout, tab
        // order and the a11y tree while STILL matching Ctrl+F, which then
        // fires beforematch and opens that column. Unsupported browsers
        // treat it as plain hidden, i.e. today's behaviour.
        if (on) e.panel.removeAttribute('hidden');
        else e.panel.setAttribute('hidden', 'until-found');
        e.col.setAttribute('aria-expanded', on ? 'true' : 'false');
        e.nav.setAttribute('aria-current', on ? 'true' : 'false');
        if (on) {
          markerEl.innerHTML = '';
          if (e.icon) markerEl.appendChild(e.icon.cloneNode(true));
          var label = document.createElement('span');
          label.textContent = e.title;
          markerEl.appendChild(label);
          if (!opened[slug]) { opened[slug] = true; track(e.title); }
        }
      });
      if (push && window.history && history.replaceState) {
        history.replaceState(null, '', '#' + slug);
      }
    }

    entries.forEach(function (e) {
      e.col.addEventListener('click', function () { open(e.slug, true); });
      e.nav.addEventListener('click', function () {
        open(e.slug, true);
        wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      // Find-in-page landed inside a closed column: open it for real.
      e.panel.addEventListener('beforematch', function () { open(e.slug, true); });
    });

    window.addEventListener('hashchange', function () {
      var s = location.hash.replace('#', '');
      if (entries.some(function (x) { return x.slug === s; })) open(s, false);
    });

    var initial = location.hash.replace('#', '');
    open(entries.some(function (x) { return x.slug === initial; }) ? initial : entries[0].slug, false);

    console.log(TAG + ' mounted ' + entries.length + ' columns ' + JSON.stringify({
      withConfig: entries.filter(function (e) { return e.panel.hasAttribute('data-m4-styled'); }).length,
      withIcon: entries.filter(function (e) { return !!e.icon; }).length,
      scenes: entries.filter(function (e) { return e.panel.hasAttribute('data-m4-scene'); })
                     .map(function (e) { return e.panel.getAttribute('data-m4-scene'); }),
      memberFormsInPanels: document.querySelectorAll('.ix-panel form[data-members-form]').length,
      memberFormsStillQueryable: document.querySelectorAll('form[data-members-form]').length
    }));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else { init(); }
})();
</script>
